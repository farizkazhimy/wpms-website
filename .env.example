# URL situs (staging/produksi). Domain final menunggu OD-WEB-01.
SITE_URL=https://staging.example.com
# true = konten berstatus "review" ikut tampil (staging). Produksi: false.
PUBLIC_SHOW_REVIEW=false
# URL web app Google Apps Script (/exec) untuk form demo dan newsletter. Lihat integrations/google-apps-script/README.md.
