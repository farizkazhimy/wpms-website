---
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  tone?: 'page' | 'champagne';
}
const { eyebrow, title, lead, tone = 'page' } = Astro.props;
---

<section
  aria-labelledby="page-title"
  class:list={[
    tone === 'champagne' ? 'bg-champagne-soft' : 'bg-surface-page',
    'border-b border-border',
  ]}
>
  <Container class="flex flex-col gap-space-4 pt-14 pb-space-7 md:pt-16">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 id="page-title" class="max-w-narrow font-display text-display-lg md:text-display-xl">
      {title}
    </h1>
    {lead && <p class="max-w-2xl text-body-lg text-ink-muted">{lead}</p>}
    <slot />
  </Container>
</section>
