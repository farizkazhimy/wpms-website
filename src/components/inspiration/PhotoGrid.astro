---
import { dict } from '~/i18n';
import { profileHref } from '~/lib/inspiration';
import type { CollectionEntry } from 'astro:content';
interface Props {
  items: CollectionEntry<'photography'>[];
}
const { items } = Astro.props;
---

<ul class="grid gap-space-5 sm:grid-cols-2 lg:grid-cols-4">
  {items.map((p) => (
    <li class="flex">
      <a
        href={profileHref('fotografi', p.id)}
        class="flex w-full flex-col overflow-hidden rounded-lg border border-border bg-surface text-ink no-underline hover:text-ink"
      >
        <div class="grid h-44 grid-cols-[2fr_1fr] grid-rows-2 gap-0.5" aria-hidden="true">
          <span class="row-span-2 bg-surface-sunken" />
          <span class="bg-neutral-soft" />
          <span class="bg-surface-sunken" />
        </div>
        <div class="flex flex-col gap-1 px-space-5 py-space-4">
          <h3 class="text-heading-sm">{dict.inspiration.photographyStyles[p.data.style]}</h3>
          <span class="text-label text-ink-muted">
            {p.data.title.split(' · ')[0]} · {p.data.city}
          </span>
        </div>
      </a>
    </li>
  ))}
</ul>
