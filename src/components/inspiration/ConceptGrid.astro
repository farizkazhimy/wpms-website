---
import { dict } from '~/i18n';
import { profileHref } from '~/lib/inspiration';
import type { CollectionEntry } from 'astro:content';
interface Props {
  items: CollectionEntry<'concept'>[];
}
const { items } = Astro.props;
---

<ul class="grid gap-space-5 md:grid-cols-2">
  {items.map((c) => (
    <li>
      <a
        href={profileHref('konsep', c.id)}
        class="relative block aspect-video overflow-hidden rounded-lg bg-surface-sunken no-underline"
      >
        <span class="absolute top-space-4 left-space-4 text-caption text-ink-muted">
          [{dict.inspiration.photoPlaceholder}]
        </span>
        <span class="absolute inset-x-0 bottom-0 flex flex-col gap-0.5 bg-ink/80 p-space-5 text-on-primary">
          <strong class="font-display text-display-md font-normal">{c.data.title}</strong>
          <span class="text-body">{c.data.summary}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
