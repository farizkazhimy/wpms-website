---
// StatusBadge: teks wajib ada; warna hanya penguat.
interface Props {
  tone?: 'neutral' | 'info' | 'warning' | 'success' | 'danger' | 'brand' | 'outline';
  class?: string;
}
const { tone = 'brand', class: cls } = Astro.props;
const map = {
  neutral: 'bg-neutral-soft text-neutral',
  info: 'bg-info-soft text-info',
  warning: 'bg-warning-soft text-warning',
  success: 'bg-success-soft text-success',
  danger: 'bg-danger-soft text-danger',
  brand: 'bg-primary-soft text-primary',
  outline: 'border border-border bg-surface text-ink',
};
---

<span
  class:list={[
    'inline-flex items-center self-start rounded-pill px-2.5 py-0.5 text-caption whitespace-nowrap',
    map[tone],
    cls,
  ]}
>
  <slot />
</span>
