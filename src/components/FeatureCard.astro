---
import Screenshot from './Screenshot.astro';
interface Props {
  name: string;
  body: string;
  image: string;
  imageAlt: string;
}
const { name, body, image, imageAlt } = Astro.props;
---

<article class="overflow-hidden rounded-lg border border-border bg-surface shadow-sm">
  <Screenshot name={image} alt={imageAlt} ratio="16/9" class="border-b border-border" />
  <div class="p-space-5">
    <h3 class="mb-1.5 text-heading-sm">{name}</h3>
    <p class="text-body text-ink-muted">{body}</p>
  </div>
</article>
