---
import Badge from './Badge.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { dict, fmt } from '~/i18n';

interface Props {
  href: string;
  title: string;
  stageLabel: string;
  readingMinutes: number;
  excerpt?: string;
  status?: 'draft' | 'review' | 'published';
  tone?: 'brand' | 'neutral';
  headingLevel?: 'h2' | 'h3';
}
const {
  href,
  title,
  stageLabel,
  readingMinutes,
  excerpt,
  status = 'published',
  tone = 'brand',
  headingLevel: H = 'h3',
} = Astro.props;
---

<a
  href={href}
  class="group flex w-full flex-col overflow-hidden rounded-lg border border-border bg-surface text-ink no-underline shadow-sm hover:text-ink"
>
  <PhotoPlaceholder label={dict.inspiration.photoPlaceholder} ratio="16/10" />
  <div class="flex flex-col gap-space-2 p-space-5">
    <div class="flex flex-wrap gap-space-2">
      <Badge tone={tone}>{stageLabel}</Badge>
      {status === 'review' && <Badge tone="warning">{dict.journal.reviewBadge}</Badge>}
    </div>
    <H class="font-display text-heading-lg font-normal group-hover:text-primary">{title}</H>
    {excerpt && <p class="text-body text-ink-muted">{excerpt}</p>}
    <span class="text-caption text-ink-muted">
      {fmt(dict.journal.readingTime, { n: readingMinutes })}
    </span>
  </div>
</a>
