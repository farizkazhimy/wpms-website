---
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  cta: string;
  href: string;
  id?: string;
}
const { eyebrow, title, body, cta, href, id } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-space-6">
  <div class="flex min-w-0 flex-1 basis-96 max-w-narrow flex-col gap-space-3">
    {eyebrow && (
      <Eyebrow onPrimary line={false}>
        {eyebrow}
      </Eyebrow>
    )}
    <h2 id={id} class="font-display text-display-md md:text-display-lg">
      {title}
    </h2>
    {body && <p class="text-body-lg">{body}</p>}
  </div>
  <Button href={href} variant="inverse" size="lg">
    {cta}
  </Button>
</div>
