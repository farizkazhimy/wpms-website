---
import Container from './Container.astro';

interface Props {
  tone?: 'page' | 'surface' | 'champagne' | 'primary';
  bordered?: boolean;
  width?: 'site' | 'wide' | 'article' | 'narrow';
  id?: string;
  labelledby?: string;
  compact?: boolean;
  class?: string;
}
const {
  tone = 'page',
  bordered = false,
  width = 'site',
  compact = false,
  id,
  labelledby,
  class: cls,
} = Astro.props;
const bg = {
  page: 'bg-surface-page',
  surface: 'bg-surface',
  champagne: 'bg-champagne-soft',
  primary: 'bg-primary text-on-primary',
}[tone];
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={[bg, bordered && 'border-y border-border', cls]}
>
  <Container width={width} class={compact ? 'py-space-6 md:py-10' : 'py-space-7 md:py-section'}>
    <slot />
  </Container>
</section>
