---
import { site } from '~/config/site';
import { dict } from '~/i18n';
const f = dict.footer;
// Akun yang belum aktif tidak ditampilkan (tracker no. 5).
const activeSocial = site.social.filter((s) => s.url);
const groups = [
  {
    title: f.groups.product,
    links: [
      { label: f.features, href: site.routes.product },
      { label: dict.nav.forWo, href: site.routes.forWo },
      { label: dict.nav.demo, href: site.routes.demo },
    ],
  },
  {
    title: f.groups.content,
    links: [
      { label: dict.nav.journal, href: site.routes.journal },
      { label: dict.nav.inspiration, href: site.routes.inspiration },
      { label: f.editorialPolicy, href: site.routes.editorial },
    ],
  },
];
---

<footer class="bg-primary text-on-primary">
  <div class="mx-auto flex max-w-site flex-col gap-space-7 px-4 pt-14 pb-space-6 md:px-space-5">
    <div class="flex flex-wrap justify-between gap-space-7">
      <img
        src="/brand/wepromys-logo-tagline-reverse.svg"
        alt={`${site.productName}, ${site.tagline}`}
        width="225"
        height="64"
        class="h-13 w-auto md:h-16"
      />
      <nav aria-label={dict.a11y.footerNav} class="flex flex-wrap gap-14 text-body">
        {groups.map((g) => (
          <div class="flex flex-col gap-2.5">
            <h2 class="text-label text-champagne-soft">{g.title}</h2>
            {g.links.map((l) => (
              <a
                href={l.href}
                class="text-on-primary no-underline hover:text-on-primary hover:underline"
              >
                {l.label}
              </a>
            ))}
          </div>
        ))}
        {activeSocial.length > 0 && (
          <div class="flex flex-col gap-2.5">
            <h2 class="text-label text-champagne-soft">{f.groups.follow}</h2>
            {activeSocial.map((s) => (
              <a
                href={s.url}
                class="text-on-primary no-underline hover:text-on-primary hover:underline"
              >
                {s.name}
              </a>
            ))}
          </div>
        )}
      </nav>
    </div>
    <div class="flex flex-wrap justify-between gap-space-3 border-t border-on-primary/30 pt-space-5 text-label">
      <span>
        © {site.copyrightYear} {site.productName} · {site.owner}
      </span>
      <span class="flex gap-space-5">
        <a href={site.routes.privacy} class="text-on-primary hover:text-on-primary">
          {f.privacy}
        </a>
        <a href={site.routes.terms} class="text-on-primary hover:text-on-primary">
          {f.terms}
        </a>
      </span>
    </div>
  </div>
</footer>
